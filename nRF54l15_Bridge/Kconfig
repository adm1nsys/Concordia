menu "XIAO nRF54L15 Sense on-board sensors"
	depends on BOARD_XIAO_NRF54L15

config BRIDGE_XIAO_IMU
	bool "Vibration / drop detection from the on-board IMU (LSM6DSO)"
	# Ported switched off: the IMU is a later step of the rebuild, and pulling
	# the sensor driver in now would test two things at once.
	default n
	select SENSOR
	select I2C
	select LSM6DSL
	help
	  Samples the on-board 6-axis IMU and exposes the result as a bridged
	  occupancy (motion) endpoint. The accelerometer is used rather than the
	  microphone: it detects both shaking and an actual drop (free fall
	  followed by an impact), and it cannot be fooled by ambient noise.

if BRIDGE_XIAO_IMU

config BRIDGE_XIAO_IMU_AUTO_ENDPOINT
	bool "Create the vibration endpoint automatically on first boot"
	default y

config BRIDGE_XIAO_IMU_STACK_SIZE
	int "Stack size of the IMU sampling thread"
	default 2048
	help
	  The sampling loop takes the Matter stack lock and performs I2C
	  transfers, so it needs its own stack rather than the shared system
	  workqueue.

config BRIDGE_XIAO_IMU_PERIOD_MS
	int "Sampling period in milliseconds"
	default 50

config BRIDGE_XIAO_IMU_VIBRATION_MG
	int "Vibration threshold (milli-g deviation from 1 g at rest)"
	default 350

config BRIDGE_XIAO_IMU_FREEFALL_MG
	int "Free-fall threshold (milli-g, total acceleration)"
	default 300

config BRIDGE_XIAO_IMU_IMPACT_MG
	int "Impact threshold after free fall (milli-g)"
	default 2000

config BRIDGE_XIAO_IMU_HOLD_S
	int "How long the endpoint stays 'detected' after a trigger (seconds)"
	default 5

endif # BRIDGE_XIAO_IMU

config BRIDGE_XIAO_MIC
	bool "Build the on-board PDM microphone driver"
	default n
	select AUDIO
	select AUDIO_DMIC
	help
	  Build-time switch that pulls in the PDM microphone driver for the Sense
	  board. Nothing in the bridge consumes audio yet - vibration detection
	  uses the IMU - so this only adds the driver to the image.

endmenu # XIAO sensors

menu "Shell access"

config BRIDGE_AUX_SHELL
	bool "Serve a second shell on the other UART"
	depends on SHELL
	default n
	help
	  Zephyr binds its UART shell to `chosen { zephyr,shell-uart }` and only
	  ever creates one instance, so the two board overlays are an either/or
	  switch: commands arrive over USB or over the header pins, never both.

	  Enable this to bring up a second, independent shell on the UART named
	  by `chosen { bridge,cmd-uart }` - the overlays point it at whichever
	  port the main shell did not take. Both instances share the same command
	  set and keep their own line buffer and history, so the ESP companion on
	  the pins and a human on the USB console do not step on each other.

	  Costs roughly 3 KB of RAM (a shell thread plus its buffers).

if BRIDGE_AUX_SHELL

config BRIDGE_AUX_SHELL_PROMPT
	string "Prompt for the second shell"
	default "aux:~$ "
	help
	  Deliberately different from the main shell's "uart:~$ " so it is
	  obvious which port you are typing on.

config BRIDGE_AUX_SHELL_INIT_PRIORITY
	int "Init priority for the second shell"
	default 91
	range 0 99
	help
	  Must be higher than both the UART driver's priority and
	  SHELL_BACKEND_SERIAL_INIT_PRIORITY (which defaults to
	  APPLICATION_INIT_PRIORITY, 90), so the built-in shell finishes
	  claiming its port first.

endif # BRIDGE_AUX_SHELL

endmenu # Shell access

endmenu # Matter bridge options

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
source "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"
source "Kconfig.zephyr"
