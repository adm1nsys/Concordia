mainmenu "Matter nRF Connect Template Example Application"

# Sample configuration used for Thread networking
if OPENTHREAD

# Full Thread Device, not the template's minimal default.
#
# The bridge is mains-powered and hosts up to a hundred endpoints a controller
# subscribes to; it should keep its radio on and route for the mesh rather than
# sleep. An MTD cannot be a parent either, so anything downstream would have to
# reach the border router directly.
#
# This costs RAM: the router tables and the larger OpenThread library are a good
# part of why the previous project sat so close to the ceiling.
choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_FTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_FTD
endchoice

# SED with 0 dBm Thread TX output power for nRF54L15 tag
if BOARD_NRF54L15TAG

config CHIP_ENABLE_ICD_SUPPORT
	default y

config OPENTHREAD_DEFAULT_TX_POWER
	default 0

endif

endif # OPENTHREAD

config CHIP_WIFI
	default y if SHIELD_NRF7002EB2

menu "Matter bridge options"

config BRIDGE_MAX_ENDPOINTS
	int "Maximum number of bridged devices"
	default 8
	range 1 240
	help
	  Size of the bridge slot table and of the Matter dynamic endpoint
	  storage. Each slot costs RAM (endpoint record + data versions +
	  Matter attribute-storage metadata), so raising this is the main
	  lever on how many devices the board can host at once.

config BRIDGE_DEBUG_LOG
	bool "Verbose bridge debug logging"
	default y
	help
	  Emit extra informational logs from the bridge. Turn this off in
	  release builds (e.g. on RAM-constrained boards) to save memory.

